{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "lib": ["ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
            "outDir": "./dist",
            "rootDir": "src",
            "resolveJsonModule": true
          },
        
            "exclude": ["node_modules", "dist", "tests", "prisma"]
          }
          